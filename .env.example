# Nukopijuokite į .env ir įrašykite savo reikšmes. Pats .env į git nepatenka.
#
# SVARBU: viskas, kas prasideda VITE_, patenka į naršyklės kodą ir yra VIEŠA.
# Čia rašykite tik tai, ką galima rodyti visiems. Slapti raktai
# (service_role, RESEND_API_KEY, CRON_SECRET) laikomi tik Supabase
# skydelyje: Edge Functions -> Secrets. Niekada ne šiame faile.

# ── Supabase (Project Settings -> API) ──
VITE_SUPABASE_URL=
# Publishable (anon) raktas. Jis skirtas naršyklei, duomenis saugo RLS taisyklės.
VITE_SUPABASE_ANON_KEY=

# ── Svetainė ──
# Pilnas adresas be / gale. Naudojamas sitemap.xml, canonical ir socialinių tinklų žymose.
VITE_SITE_URL=https://forcoaches.lt
# Rodomas puslapio apačioje, kontaktuose ir privatumo politikoje.
VITE_CONTACT_EMAIL=
# Per kiek laiko atsakote. Rašykite tik tai, ko tikrai laikotės.
VITE_RESPONSE_TIME=1 darbo dieną

# ── Įmonės rekvizitai (privatumo politika, vietos verslo žymėjimas) ──
VITE_COMPANY_NAME=
VITE_COMPANY_CODE=
VITE_COMPANY_STREET=
VITE_COMPANY_CITY=Vilnius
VITE_COMPANY_POSTAL=
VITE_COMPANY_PHONE=

# ── Google Analytics 4 (Admin -> Data streams -> Measurement ID, pvz. G-XXXXXXX) ──
# Tuščias = analitika ir slapukų juosta išjungtos.
VITE_GA_ID=
